{
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js?pathname=:path*"
    },
    {
      "source": "/:path*",
      "destination": "/public/:path*"
    }
  ]
}
