{
  "version": 2,
  "regions": ["sin1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js?pathname=$1"
    },
    { "src": "/sitemap.xml", "dest": "/api/index.js?pathname=sitemap" },
    { "src": "/title/(.*)", "dest": "/public/index.html" },
    { "src": "/watch/(.*)", "dest": "/public/index.html" },
    { "src": "/search", "dest": "/public/index.html" },
    { "src": "/reminders", "dest": "/public/index.html" },
    { "src": "/collection", "dest": "/public/index.html" },
    { "src": "/account", "dest": "/public/index.html" },
    { "src": "/history", "dest": "/public/index.html" },
    { "src": "/profile", "dest": "/public/index.html" },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
